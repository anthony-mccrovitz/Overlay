# Get a free API key at https://the-odds-api.com
ODDS_API_KEY=your_key_here

# OpenWeatherMap — free tier, for weather features in model
OPENWEATHER_API_KEY=your_key_here

# Stripe — free to sign up, 2.9% + $0.30 per transaction
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create product "EdgeFinder Pro" at $35/mo → copy Price ID here
STRIPE_PRICE_ID=price_...

# Kalshi — CFTC-regulated prediction market (kalshi.com)
# Create account at kalshi.com, then use email/password below OR set API key
# API key available at: https://kalshi.com/profile/api
KALSHI_EMAIL=your@email.com
KALSHI_PASSWORD=yourpassword
KALSHI_API_KEY=  # optional, replaces email/password if set

# Polymarket — no credentials needed (public read API)
