# Auth
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Resend SMTP (free tier: 100 emails/day, 3000/mo)
# 1. Sign up at resend.com
# 2. Verify a sending domain (or use onboarding@resend.dev while testing)
# 3. Create an API key, paste it as EMAIL_SERVER_PASSWORD below
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=re_your_resend_api_key_here
EMAIL_FROM="Overlay <onboarding@resend.dev>"

# Free-list lead capture (/api/lead). Reuses the Resend key above.
# RESEND_API_KEY is preferred; falls back to EMAIL_SERVER_PASSWORD if unset.
# RESEND_AUDIENCE_ID: create an Audience in the Resend dashboard and paste its
# id here so captured emails land in a list you can broadcast free plays to.
# If omitted, signups still send a welcome email but aren't stored in a list.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_AUDIENCE_ID=

# Subscriber allowlist — comma-separated lowercase emails
# Manually add a customer's email here after they pay
PAID_EMAILS=

# Stripe payment link (created after deploy, paste URL here)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/TODO
